type Query {
    "Skolor som erbjuder ett program, valfritt filtrerat på kommuner. Sorterade på namn."
    schools(
        "Programkod, t.ex. TE25 (Teknikprogrammet)."
        program: ID!
        "Kommunkoder, t.ex. [\"0114\", \"0163\"]. Tom lista eller utelämnad = hela Sverige."
        municipalities: [ID!]
    ): [School!]!

    "En skola via Skolverkets skolenhetskod."
    school(code: ID!): School

    "Alla gymnasieprogram, sorterade på namn."
    programs: [Program!]!

    "Alla kommuner, sorterade på namn."
    municipalities: [Municipality!]!

    "Arbetsytan som nyckeln i headern X-Workspace-Key leder till. Null utan giltig nyckel."
    workspace: Workspace
}

type Mutation {
    "Skapar en ny arbetsyta. Nycklarna returneras bara här, spara dem i länken."
    createWorkspace: CreatedWorkspace!

    "Bevakar en skola för ett program. Kräver redigeringsnyckeln."
    watchSchool(school: ID!, program: ID!): Workspace!

    "Slutar bevaka en skola. Kräver redigeringsnyckeln."
    unwatchSchool(school: ID!): Workspace!

    "Sätter meritvärdet (0–340), eller tar bort det med null."
    setMerit(merit: Float): Workspace!

    "Sätter hur viktigt ett kriterium är (0–5)."
    setWeight(criterion: Criterion!, weight: Int!): Workspace!

    "Sätter ett betyg 1–5 på en bevakad skola, eller tar bort det med null."
    setScore(school: ID!, criterion: Criterion!, score: Int): Workspace!

    "Sätter status på en bevakad skola, eller tar bort den med null."
    setStatus(school: ID!, status: WatchStatus): Workspace!

    "Sparar en anteckning om en bevakad skola. Tom text tar bort den."
    setNote(school: ID!, note: String): Workspace!
}

"En ny arbetsyta med sina nycklar i klartext."
type CreatedWorkspace {
    "Ger full åtkomst. Lägg i länken som #k=…"
    editKey: String!
    "Ger bara läsåtkomst."
    viewKey: String!
    workspace: Workspace!
}

"All sparad data för en person eller familj, utan konto."
type Workspace {
    id: ID!
    "Vad nyckeln som användes ger rätt till."
    access: AccessLevel!
    "Läsnyckeln, för att kunna dela en skrivskyddad länk. Bara med redigeringsnyckeln."
    viewKey: String
    "Meritvärdet (max 340) som antagningschansen räknas mot."
    meritValue: Float
    "Vikt 0–5 per kriterium, alltid alla kriterier."
    weights: [Weight!]!
    watchedSchools: [WatchedSchool!]!
}

"Hur viktigt ett kriterium är, 0 = spelar ingen roll, 5 = viktigast."
type Weight {
    criterion: Criterion!
    weight: Int!
}

"Ett betyg 1–5 på ett kriterium."
type Score {
    criterion: Criterion!
    score: Int!
}

enum Criterion {
    "Dörr till dörr, antal byten."
    RESTID
    "Finns inriktningen man vill läsa?"
    INRIKTNING
    "Antagningspoäng: studiemiljö och konkurrens."
    POANG
    "Rykte och resultat."
    RYKTE
    "Profil, t.ex. robotik, spel, spets, fjärde år."
    PROFIL
    "Skolmiljö: lokaler, labb, storlek, stämning."
    MILJO
    "Intryck från öppet hus."
    BESOK
}

enum AccessLevel {
    EDIT
    VIEW
}

"En bevakad skola, för det program den bevakades för."
type WatchedSchool {
    school: School!
    program: Program!
    status: WatchStatus
    note: String
    "Satta betyg. Kriterier utan betyg saknas i listan."
    scores: [Score!]!
    "Viktat medel (0–5) av satta betyg. Null om inga betyg finns."
    totalScore: Float
    "Antal kriterier som saknar betyg."
    missingScores: Int!
}

enum WatchStatus {
    INTRESSANT
    BESOK
    BESOKT
    BORTVALD
}

"En gymnasieskola (skolenhet) enligt Skolverket."
type School {
    "Skolverkets skolenhetskod."
    code: ID!
    name: String!
    "Huvudmannens namn, t.ex. kommunen eller företaget som driver skolan."
    organizerName: String
    organizerType: OrganizerType
    municipality: Municipality
    street: String
    zipCode: String
    city: String
    latitude: Float
    longitude: Float
    webUrl: String
    status: SchoolStatus!
    "Program som skolan erbjuder för nästa läsår."
    programs: [SchoolProgram!]!
}

"Ett program på en viss skola, med antagningspoäng och inriktningar."
type SchoolProgram {
    program: Program!
    "Lägsta antagningspoäng senaste antagningen. Saknas om inget tal finns."
    admissionPointsMin: Float
    "Genomsnittlig antagningspoäng senaste antagningen."
    admissionPointsAvg: Float
    "Året antagningspoängen gäller."
    admissionYear: Int
    "Text när poängen inte är ett tal, t.ex. \"alla antagna\"."
    admissionNote: String
    studyPaths: [StudyPath!]!
}

"En inriktning inom ett program."
type StudyPath {
    code: ID!
    name: String!
}

type Program {
    "T.ex. TE25."
    code: ID!
    name: String!
    category: ProgramCategory!
}

enum ProgramCategory {
    "De sex nationella högskoleförberedande programmen."
    HOGSKOLEFORBEREDANDE
    "De tolv nationella yrkesprogrammen."
    YRKES
    "Riksrekryterande utbildningar, introduktionsprogram, IB m.m."
    OVRIGA
}

type Municipality {
    "SCB:s kommunkod, t.ex. 0114."
    code: ID!
    name: String!
    "Länet kommunen ligger i, t.ex. Stockholms län."
    county: String
}

enum OrganizerType {
    KOMMUNAL
    KOMMUNALFORBUND
    REGION
    FRISTAENDE
}

enum SchoolStatus {
    AKTIV
    VILANDE
    UPPHORT
    PLANERAD
}
